{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend 2>/dev/null || true; npm install",
  "buildCommand": "cd frontend 2>/dev/null || true; npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/(models|predict|compare|metrics|dataset-info|dataset|recommend)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
